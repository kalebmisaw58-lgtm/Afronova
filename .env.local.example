# ─────────────────────────────────────────────────────────────
# AfroNova — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── RESEND (email delivery) ───────────────────────────────────
# Sign up at https://resend.com — free tier: 100 emails/day
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address for all outgoing emails.
# Must be a verified domain in your Resend dashboard.
# While testing you can use: onboarding@resend.dev
RESEND_FROM_EMAIL=noreply@afronova.org
RESEND_FROM_NAME=AfroNova

# Where all form submissions are forwarded to
CONTACT_TO_EMAIL=tesfaye.afronova@gmail.com

# ── SUPABASE (database) ───────────────────────────────────────
# Sign up at https://supabase.com — free tier: 500MB DB
# Found in: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://amkbuftsfyetbcypzyrk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_mCClcrSmcw2psLBHpMSdcQ_K4DCbvEi
# Service role key — server-side only, NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx

# ── NEWSLETTER (Mailchimp, optional) ──────────────────────────
# Sign up at https://mailchimp.com — free tier: 500 contacts
# API key: Account → Extras → API keys
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
# Audience/List ID: Audience → Settings → Audience name and defaults
MAILCHIMP_AUDIENCE_ID=xxxxxxxxxx
# Data center prefix from your API key (e.g. us21)
MAILCHIMP_DC=us21

# ── APP ───────────────────────────────────────────────────────
# Development: http://localhost:3001
# Production:  https://afronova.org
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional: protects detailed health checks. Send as: Authorization: Bearer <token>
HEALTHCHECK_TOKEN=replace-with-a-long-random-secret
